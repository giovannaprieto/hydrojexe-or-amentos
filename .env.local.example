# =============================================================================
# Hydrojexe - variáveis de ambiente
# Copie para `.env.local` e preencha com os valores do seu projeto Supabase.
# Supabase Dashboard > Project Settings > API
# =============================================================================

# URL do projeto (ex.: https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key (pode ir para o client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key — NUNCA expor no client. Só para scripts/rotas server-side.
SUPABASE_SERVICE_ROLE_KEY=
